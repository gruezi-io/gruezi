---
gruezi_failure_policy: strict
gruezi_bind: 0.0.0.0:9375
gruezi_interface: eth0
gruezi_group_id: example-ha
gruezi_shared_key: replace-with-a-private-shared-key-at-least-16-bytes
gruezi_preempt: false
gruezi_advert_interval_ms: 1000
gruezi_dead_factor: 3
gruezi_hold_down_ms: 3000
gruezi_jitter_ms: 100
gruezi_withdraw_timeout_ms: 5000
gruezi_command_timeout_ms: 3000
gruezi_watchdog_mode: off
gruezi_watchdog_device: /dev/watchdog0
gruezi_watchdog_timeout_ms: 15000
gruezi_watchdog_safety_margin_ms: 2000
gruezi_watchdog_nowayout: reject

# Required only when gruezi_failure_policy is external.
gruezi_authority_check_command: /usr/local/bin/gruezi-authority-check
gruezi_authority_fence_command: ''
gruezi_authority_interval_ms: 1000
gruezi_authority_grant_ttl_ms: 5000
