mode: ha
node:
  id: node-@NODE@
ha:
  failure_policy: strict
  peer_id: node-@PEER@
  bind: @IP@:9375
  peer: @PEER_IP@:9375
  interface: eth0
  addresses: [10.249.15.100/24]
  group_id: mariadb-lab
  priority: @PRIORITY@
  preempt: false
  advert_interval_ms: 200
  dead_factor: 3
  hold_down_ms: 400
  jitter_ms: 0
  command_timeout_ms: 10000
  withdraw_timeout_ms: 15000
  watchdog:
    mode: off
  lifecycle:
    activate_command: /usr/local/libexec/lifecycle-wrapper
    deactivate_command: /usr/local/libexec/lifecycle-wrapper
    timeout_ms: 8000
  auth:
    key: @KEY@
