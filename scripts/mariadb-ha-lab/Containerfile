FROM ubuntu:24.04
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates iproute2 iputils-arping ndisc6 iptables curl mariadb-client \
    && rm -rf /var/lib/apt/lists/*
COPY target/release/gruezi /usr/local/bin/gruezi
COPY scripts/mariadb-ha-lab/read-only-hook.sh /usr/local/bin/read-only-hook
RUN chmod 755 /usr/local/bin/read-only-hook
ENTRYPOINT ["/usr/local/bin/gruezi"]
